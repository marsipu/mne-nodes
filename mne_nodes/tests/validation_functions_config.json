{
    "test_filter": {
        "inputs": {
            "raw": {
                "accepted_ports": [
                    "raw"
                ],
                "optional": false
            }
        },
        "parameters": {
            "l_freq": {
                "none_select": true,
                "default": null,
                "gui": "FloatGui"
            },
            "h_freq": {
                "none_select": true,
                "default": null,
                "gui": "FloatGui"
            },
            "n_jobs": {
                "none_select": true,
                "types": [
                    "int",
                    "str"
                ],
                "default": -1,
                "gui": "MultiTypeGui"
            }
        },
        "outputs": {
            "raw": {
                "accepted_ports": [
                    "raw"
                ],
                "optional": false
            }
        },
        "target": "file"
    },
    "test_epochs": {
        "inputs": {
            "raw": {
                "accepted_ports": [
                    "raw"
                ],
                "optional": false
            }
        },
        "parameters": {
            "events": {
                "none_select": true,
                "default": null,
                "gui": "MultiTypeGui"
            },
            "event_id": {
                "none_select": true,
                "default": null,
                "gui": "DictGui"
            },
            "t_epoch": {
                "default": {
                    "tuple_type": [
                        0,
                        1
                    ]
                },
                "gui": "DualTupleGui"
            },
            "baseline": {
                "none_select": true,
                "default": null,
                "gui": "DualTupleGui"
            }
        },
        "outputs": {
            "epochs": {
                "accepted_ports": [
                    "epochs"
                ],
                "optional": false,
                "write": "Epochs.save",
                "suffix": "epo"
            }
        },
        "target": "file"
    },
    "test_evokeds": {
        "inputs": {
            "epochs": {
                "accepted_ports": [
                    "epochs"
                ],
                "optional": false,
                "read": "read_epochs",
                "write": "Epochs.save",
                "suffix": "epo"
            }
        },
        "parameters": {
            "conditions": {
                "none_select": true,
                "default": null,
                "gui": "ListGui"
            }
        },
        "outputs": {
            "evokeds": {
                "accepted_ports": [
                    "evokeds"
                ],
                "optional": true,
                "suffix": "ave",
                "write": "write_evokeds"
            }
        },
        "target": "file"
    },
    "test_plot_evokeds": {
        "inputs": {
            "evokeds": {
                "accepted_ports": [
                    "evokeds"
                ],
                "optional": false,
                "suffix": "ave",
                "read": "read_evokeds"
            }
        },
        "parameters": {},
        "outputs": {},
        "target": "file"
    },
    "read_epochs": {
        "inputs": {},
        "parameters": {
            "fname": {
                "none_select": false,
                "default": "",
                "gui": "PathGui"
            }
        },
        "outputs": {},
        "target": "file",
        "module_name": "mne",
        "class_name": null
    },
    "Epochs.save": {
        "inputs": {
            "epochs": {
                "accepted_ports": [
                    "epochs"
                ],
                "optional": false,
                "read": "read_epochs",
                "suffix": "epo"
            }
        },
        "parameters": {
            "fname": {
                "none_select": false,
                "default": "",
                "gui": "PathGui"
            },
            "overwrite": {
                "none_select": false,
                "default": true,
                "gui": "BoolGui"
            }
        },
        "outputs": {},
        "target": "file",
        "module_name": "mne",
        "class_name": "Epochs"
    },
    "read_evokeds": {
        "inputs": {},
        "parameters": {
            "fname": {
                "none_select": false,
                "default": "",
                "gui": "PathGui"
            }
        },
        "outputs": {},
        "target": "file",
        "module_name": "mne",
        "class_name": null
    },
    "write_evokeds": {
        "inputs": {
            "evokeds": {
                "accepted_ports": [
                    "evokeds"
                ],
                "optional": false,
                "read": "read_evokeds",
                "suffix": "ave"
            }
        },
        "parameters": {
            "fname": {
                "none_select": false,
                "default": "",
                "gui": "PathGui"
            },
            "overwrite": {
                "none_select": false,
                "default": true,
                "gui": "BoolGui"
            }
        },
        "outputs": {},
        "target": "file",
        "module_name": "mne",
